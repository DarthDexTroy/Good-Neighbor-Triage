# Copy to backend/.env and fill in. Never commit .env.

# 1 = simulated replies stream in after "Check in all", and fake numbers use the mock messenger.
DEMO_MODE=1
# 1 real second = SIM_SPEED/60 simulated minutes (60 => 1 real second = 1 sim minute).
SIM_SPEED=60

# NVIDIA Nemotron (build.nvidia.com). Leave blank to use the rule-based fallback agent.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Pick a current Nemotron model that supports tool calling and paste its ID from build.nvidia.com
NEMOTRON_MODEL=

# Photon 2.0. Leave blank to use the mock messenger.
PHOTON_API_KEY=
# Only these real numbers (E.164, comma separated) ever get real messages. Live inbound texters are allowed automatically.
ALLOWED_REAL_NUMBERS=
