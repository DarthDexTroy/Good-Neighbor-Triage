# Copy to backend/.env and fill in. Never commit .env.

# 1 = simulated replies stream in after "Check in all", and fake numbers use the mock messenger.
DEMO_MODE=1
# 1 real second = SIM_SPEED/60 simulated minutes (60 => 1 real second = 1 sim minute).
SIM_SPEED=60

# NVIDIA Nemotron (build.nvidia.com). Leave blank to use the rule-based fallback agent.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Defaults to nvidia/nemotron-3.5-super-vl-120b-a12b. Fallback if slow: nvidia/nemotron-3.5-lightning-30b-a3b
NEMOTRON_MODEL=
# 1 = let the model "think" before answering (slower). Off for the live demo.
NEMOTRON_THINKING=0

# Photon 2.0 beta. Leave blank to use the mock messenger.
# Project API key (pho_sk_..., needs project:read + project:write) and Project ID (pho_prj_...).
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
PHOTON_PLATFORM=imessage
# Your own iPhone number (E.164). The demo family (Reyes) uses it, so real iMessages reach you.
# Shared lines can't text first: send "hola" to the agent number from this phone before the demo.
DEMO_FAMILY_PHONE=
# Only these real numbers (E.164, comma separated) ever get real messages. Live inbound texters are allowed automatically.
ALLOWED_REAL_NUMBERS=
